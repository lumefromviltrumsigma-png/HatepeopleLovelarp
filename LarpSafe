local TugHelperEnabled = false
local TugHelperBusy = false

local function TugGetCurrentGame()
    local values = Workspace:FindFirstChild("Values")
    values = values and values:FindFirstChild("CurrentGame")
    if values and values.Value ~= "" then
        return values.Value
    end
    return nil
end

local function TugHelperRun()
    if TugHelperBusy then return end
    TugHelperBusy = true

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then TugHelperBusy = false return end

    local tugUI = playerGui:WaitForChild("TugOfWarUIV2", 5)
    if not tugUI then TugHelperBusy = false return end

    local remake = tugUI:FindFirstChild("TugofWarRemake")
    if not remake then TugHelperBusy = false return end

    local circleBase = remake:FindFirstChild("CircleBase")
    if not circleBase then TugHelperBusy = false return end

    while TugHelperEnabled do
        local phase = nil
        pcall(function() phase = LocalPlayer:GetAttribute("TugOfWarPhase") end)
        if phase == "QTE" then break end
        if TugGetCurrentGame() ~= "TugOfWar" then
            TugHelperBusy = false
            return
        end
        task.wait(0.1)
    end
    if not TugHelperEnabled then TugHelperBusy = false return end

    local arrow = circleBase:FindFirstChild("Arrow")
    if not arrow then TugHelperBusy = false return end

    local medium = circleBase:FindFirstChild("Medium")
        or circleBase:FindFirstChild("Small")
        or circleBase:FindFirstChild("Large")
    if not medium then TugHelperBusy = false return end

    local conn = nil
    local childConn = nil
    local stopped = false

    local function cleanup()
        if stopped then return end
        stopped = true
        if conn then pcall(function() conn:Disconnect() end) conn = nil end
        if childConn then pcall(function() childConn:Disconnect() end) childConn = nil end
        TugHelperBusy = false
    end

    childConn = LocalPlayer.ChildAdded:Connect(function(child)
        if child.Name == "QTEOver" then cleanup() end
    end)

    conn = RunService.RenderStepped:Connect(function()
        if not TugHelperEnabled then cleanup() return end
        if not arrow.Parent or not circleBase.Visible then cleanup() return end
        if TugGetCurrentGame() ~= "TugOfWar" then cleanup() return end

        local arrowRot = arrow.Rotation % 360
        pcall(function()
            medium.Rotation = arrowRot
        end)
    end)

    task.spawn(function()
        while TugHelperBusy and TugHelperEnabled and TugGetCurrentGame() == "TugOfWar" do
            task.wait(1)
        end
        cleanup()
    end)
end

local function TugHelperStart()
    if TugGetCurrentGame() == "TugOfWar" then
        task.spawn(TugHelperRun)
    end
end

local function TugHelperStop()
    TugHelperBusy = false
end

