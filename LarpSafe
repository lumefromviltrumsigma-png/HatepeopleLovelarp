local function glassProcessModel(adornee)
    if not adornee:IsA("Model") or not adornee.PrimaryPart then return end
    local primaryPart = adornee.PrimaryPart
    local isBreakable = primaryPart:GetAttribute("exploitingisevil")

    if GlassESPEnabled and not espObjects[adornee] then
        local highlight = Instance.new("Highlight")
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = Color3.new(1, 1, 1)

        if isBreakable then
            highlight.FillColor = Color3.fromRGB(255, 50, 50)
            highlight.Name = "BreakableHighlight"
        else
            highlight.FillColor = Color3.fromRGB(50, 255, 50)
            highlight.Name = "SafeHighlight"
        end

        highlight.Adornee = adornee
        highlight.Parent = adornee
        espObjects[adornee] = highlight
    end

    local shouldCreateFake = isBreakable
    if FakeGlassEnabled then
