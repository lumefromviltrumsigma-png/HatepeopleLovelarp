local function CloseMenu()
    if isAnimating or not open then return end
    isAnimating = true

    local tweenSize = TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.fromOffset(WINDOW_W, 0)})
    tweenSize:Play()
    tweenSize.Completed:Connect(function()
        Main.Visible = false
        Main.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)
        open = false
        isAnimating = false
        OpenBtn.Size = UDim2.fromOffset(34, 34)
        TweenService:Create(OpenBtn, EASE.Bounce, {Size = UDim2.fromOffset(42, 42)}):Play()
    end)
end

local function OpenMenu()
    if isAnimating or open then return end
    isAnimating = true

    Main.Visible = true
    Main.Size = UDim2.fromOffset(WINDOW_W, 0)
    local tweenSize = TweenService:Create(Main, EASE.Smooth, {Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)})
    tweenSize:Play()
    tweenSize.Completed:Connect(function()
        open = true
        isAnimating = false
    end)
end

