-- ============================================================
--  AUTO PICKUP KEYS  (Hide & Seek)
-- ============================================================

local AutoPickupKeysEnabled = false

local function HNS_is_game_active(arg)
    if not arg then return true end

    local values = Workspace:FindFirstChild("Values")
    if not values then return false end
    local currentGame = values:FindFirstChild("CurrentGame")
    if not currentGame then return false end
    local value = currentGame.Value
    if value == arg then return true end

    if arg == "HideAndSeek" and (value == "HideAndSeek" or value == "Hide & Seek") then
        return true
    end

    return false
end

local function toggle_auto_pickup_keys(enabled)
    if enabled then
        if not HNS_is_game_active("HideAndSeek") then
            PlayToggleSound()
            return false
        end
    end

    AutoPickupKeysEnabled = enabled

    if enabled then
        task.spawn(function()
            local values = Workspace:FindFirstChild("Values")
            if not values then
                AutoPickupKeysEnabled = false
                return
            end
            local currentGame = values:FindFirstChild("CurrentGame")

            if not currentGame or currentGame.Value ~= "HideAndSeek" then
                AutoPickupKeysEnabled = false
                return
            end

            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

            local function hasKey(name)
                local currentKeys = LocalPlayer:FindFirstChild("CurrentKeys")
                return currentKeys and currentKeys:FindFirstChild(name) ~= nil
            end

            local function missingKeys()
                local list = {}
                for _, keyName in ipairs({ "Circle", "Triangle", "Square" }) do
                    if not hasKey(keyName) then
                        table.insert(list, keyName)
                    end
                end
                return list
            end

            local function tpTo(pos)
                if humanoidRootPart and humanoidRootPart.Parent then
                    humanoidRootPart.CFrame = CFrame.new(pos)
                end
            end

            local function fireKeyPrompt(prompt)
                if not prompt or not prompt:IsA("ProximityPrompt") then return false end

                if fireproximityprompt then
                    pcall(function() fireproximityprompt(prompt) end)
                elseif syn and syn.proximityprompt then
                    pcall(function() syn.proximityprompt(prompt) end)
                else
                    local holdDuration = prompt.HoldDuration
                    prompt.HoldDuration = 0
                    pcall(function()
                        prompt:InputHoldBegin()
                        task.wait(0.05)
                        prompt:InputHoldEnd()
                    end)
                    prompt.HoldDuration = holdDuration
                end

                return true
            end

            local function scanKeys()
                local found = {}

                local effects = Workspace:FindFirstChild("Effects")
                if effects then
                    for _, child in pairs(effects:GetChildren()) do
                        if child:IsA("Model") and string.find(child.Name or "", "Key") then
                            local keyName
                            if string.find(child.Name, "Circle") then
                                keyName = "Circle"
                            elseif string.find(child.Name, "Triangle") then
                                keyName = "Triangle"
                            elseif string.find(child.Name, "Square") then
                                keyName = "Square"
                            end

                            if keyName then
                                local primaryPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                                if primaryPart then
                                    table.insert(found, { name = keyName, position = primaryPart.Position, model = child })
                                end
                            end
                        end
                    end
                end

                local hideAndSeekMap = Workspace:FindFirstChild("HideAndSeekMap")
                if hideAndSeekMap then
                    local function recurse(instance)
                        for _, child in pairs(instance:GetChildren()) do
                            if child:IsA("Model") then
                                local name = child.Name or ""
                                if string.find(name, "Circle") or string.find(name, "Triangle") or string.find(name, "Square") then
                                    local keyName
                                    if string.find(name, "Circle") then
                                        keyName = "Circle"
                                    elseif string.find(name, "Triangle") then
                                        keyName = "Triangle"
                                    elseif string.find(name, "Square") then
                                        keyName = "Square"
                                    end

                                    if keyName then
                                        local primaryPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                                        if primaryPart then
                                            table.insert(found, { name = keyName, position = primaryPart.Position, model = child })
                                        end
                                    end
                                end
                            end
                            recurse(child)
                        end
                    end
                    recurse(hideAndSeekMap)
                end

                return found
            end

            local pickedCache = {}

            while AutoPickupKeysEnabled do
                if HNS_is_game_active("HideAndSeek") then
                    if LocalPlayer:GetAttribute("IsHunter") == true then
                        task.wait(1)
                        continue
                    elseif not LocalPlayer:FindFirstChild("Escaped") then
                        local missing = missingKeys()

                        if #missing ~= 0 then
                            local keys = scanKeys()

                            for _, keyData in pairs(keys) do
                                if AutoPickupKeysEnabled then
                                    if table.find(missing, keyData.name) and not pickedCache[keyData.name] then
                                        tpTo(keyData.position + Vector3.new(0, 3, 0))
                                        task.wait(0.1)

                                        local proximityPrompt = nil
                                        if keyData.model then
                                            proximityPrompt = keyData.model:FindFirstChildOfClass("ProximityPrompt")

                                            if not proximityPrompt then
                                                for _, descendant in pairs(keyData.model:GetDescendants()) do
                                                    if descendant:IsA("ProximityPrompt") then
                                                        proximityPrompt = descendant
                                                        break
                                                    end
                                                end
                                            end
                                        end

                                        if proximityPrompt then
                                            fireKeyPrompt(proximityPrompt)
                                            pickedCache[keyData.name] = true
                                            PlayBell()
                                        end

