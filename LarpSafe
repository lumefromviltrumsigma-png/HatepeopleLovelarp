local ESPRolesEnabled = false
local espRoleHighlights = {}
local espRoleConnections = {}

local function UpdateESPRole(player)
    if not ESPRolesEnabled then return end
    if player == LocalPlayer then return end

    local character = player.Character
    if not character then return end

    if espRoleHighlights[player] then
        espRoleHighlights[player]:Destroy()
        espRoleHighlights[player] = nil
    end

    local isHider = player:GetAttribute("IsHider")
    local isHunter = player:GetAttribute("IsHunter")

    if not isHider and not isHunter then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "LarpESPRole_Highlight"
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0

    if isHider then
        highlight.FillColor = Color3.fromRGB(50, 255, 50)
        highlight.OutlineColor = Color3.fromRGB(30, 200, 30)
    elseif isHunter then
        highlight.FillColor = Color3.fromRGB(255, 50, 50)
        highlight.OutlineColor = Color3.fromRGB(200, 30, 30)
    end

    highlight.Adornee = character
    highlight.Parent = character
    espRoleHighlights[player] = highlight
end

local function CleanupESPRoles()
    for _, conn in pairs(espRoleConnections) do
        if conn and conn.Connected then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(espRoleConnections)

    for _, hl in pairs(espRoleHighlights) do
        if hl and hl.Parent then
            pcall(function() hl:Destroy() end)
        end
    end
    table.clear(espRoleHighlights)
end

local function BindESPRole(player)
    if player == LocalPlayer then return end

    table.insert(espRoleConnections, player:GetAttributeChangedSignal("IsHider"):Connect(function()
        if ESPRolesEnabled then UpdateESPRole(player) end
    end))
    table.insert(espRoleConnections, player:GetAttributeChangedSignal("IsHunter"):Connect(function()
        if ESPRolesEnabled then UpdateESPRole(player) end
    end))
    table.insert(espRoleConnections, player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if ESPRolesEnabled then UpdateESPRole(player) end
    end))

    UpdateESPRole(player)
end

tglEspRoles.Button.MouseButton1Click:Connect(function()
    ESPRolesEnabled = not ESPRolesEnabled
    SetToggleVisual(tglEspRoles, ESPRolesEnabled)

    if ESPRolesEnabled then
        CleanupESPRoles()

        for _, player in pairs(Players:GetPlayers()) do
            BindESPRole(player)
        end

        table.insert(espRoleConnections, Players.PlayerAdded:Connect(function(player)
            task.wait(1)
            if ESPRolesEnabled then BindESPRole(player) end
        end))

        table.insert(espRoleConnections, Players.PlayerRemoving:Connect(function(player)
            if espRoleHighlights[player] then
                espRoleHighlights[player]:Destroy()
                espRoleHighlights[player] = nil
            end
        end))
    else
        CleanupESPRoles()
    end
end)

