        TweenService:Create(toggle.Track, EASE.Out, {BackgroundColor3 = COLORS.Accent}):Play()
        TweenService:Create(toggle.TrackStroke, EASE.Out, {Color = COLORS.Accent, Transparency = 0}):Play()
        TweenService:Create(toggle.Knob, EASE.Bounce, {Position = UDim2.new(1, -12, 0.5, -5), BackgroundColor3 = COLORS.KnobOn}):Play()
    else
        TweenService:Create(toggle.Track, EASE.Out, {BackgroundColor3 = COLORS.TrackOff}):Play()
        TweenService:Create(toggle.TrackStroke, EASE.Out, {Color = COLORS.BorderHover, Transparency = 0.35}):Play()
        TweenService:Create(toggle.Knob, EASE.Out, {Position = UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = COLORS.KnobOff}):Play()
