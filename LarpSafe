local espPowersEnabled = false
local espPowerConns = {}
local espPowerBillboards = {}

local function updatePowerESP(arg)
    if not arg or not arg.Character then
        return
    end
    local head = arg.Character:FindFirstChild("Head")
    local attribute = arg:GetAttribute("_EquippedPower")

    if espPowersEnabled and head and attribute and attribute ~= "" and attribute ~= "None" and attribute ~= "Yok" then
        local text = tostring(attribute)
        local v3 = espPowerBillboards[arg]

        if not v3 then
            local billboardGui = Instance.new("BillboardGui")
            billboardGui.Name = "PowerESP"
            billboardGui.AlwaysOnTop = false
            billboardGui.Size = UDim2.new(0, 100, 0, 20)
            billboardGui.StudsOffset = Vector3.new(0, 1.5, 0)
            local textLabel = Instance.new("TextLabel")
            textLabel.BackgroundTransparency = 1
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.Text = text
            textLabel.TextColor3 = Color3.new(1, 1, 1)
            textLabel.Font = Enum.Font.Arcade
            textLabel.TextSize = 10
            textLabel.TextStrokeTransparency = 0.5
            textLabel.Parent = billboardGui
            billboardGui.Parent = head
            espPowerBillboards[arg] = billboardGui
        else
            if v3.Parent ~= head then
                v3.Parent = head
            end

            local textLabel = v3:FindFirstChildOfClass("TextLabel")

            if textLabel then
                textLabel.Text = text
            end
        end
    elseif espPowerBillboards[arg] then
        espPowerBillboards[arg]:Destroy()
        espPowerBillboards[arg] = nil
    end
end

local function bindPowerESPPlayer(arg)
    if espPowerConns[arg] then
        espPowerConns[arg]:Disconnect()
        espPowerConns[arg] = nil
    end

    espPowerConns[arg] = arg:GetAttributeChangedSignal("_EquippedPower"):Connect(function()
        updatePowerESP(arg)
    end)

    espPowerConns[arg.Name .. "_char"] = arg.CharacterAdded:Connect(function()
        task.wait(1)

        if espPowersEnabled then
            updatePowerESP(arg)
        end
    end)

    updatePowerESP(arg)
end

local function clearAllPowerESP()
    for _, v3 in pairs(espPowerConns) do
        if v3 and v3.Disconnect then
            pcall(function() v3:Disconnect() end)
        end
    end

    table.clear(espPowerConns)

    for _, v3 in pairs(espPowerBillboards) do
        if v3 then
            pcall(function() v3:Destroy() end)
        end
    end

    table.clear(espPowerBillboards)
end

local function setPowerESP(enabled)
    espPowersEnabled = enabled

    if espPowersEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                bindPowerESPPlayer(player)
            end
        end

        espPowerConns._PlayerAdded = Players.PlayerAdded:Connect(function(player)
            if espPowersEnabled then
                bindPowerESPPlayer(player)
            end
        end)
    else
        clearAllPowerESP()
    end
end

